# Backend API URL (Vercel proxies /api to this in production)
# For local dev, the Vite proxy handles /api -> localhost:8000
VITE_API_URL=

# WebSocket URL (wss:// backend URL for voice calls)
# For local dev, the Vite proxy handles /ws -> ws://localhost:8000
VITE_WS_URL=

# --- Backend keys (set in Fly.io dashboard, not here) ---
# GROQ_API_KEY=gsk_...
# RIME_API_KEY=...
