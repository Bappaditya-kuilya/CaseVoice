{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://towards-sauce-degree-chemical.trycloudflare.com/api/$1" },
    { "source": "/ws/(.*)", "destination": "wss://towards-sauce-degree-chemical.trycloudflare.com/ws/$1" }
  ]
}
