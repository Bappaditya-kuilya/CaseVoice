{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://casevoice-backend.up.railway.app/api/$1" },
    { "source": "/ws/(.*)", "destination": "wss://casevoice-backend.up.railway.app/ws/$1" }
  ]
}
